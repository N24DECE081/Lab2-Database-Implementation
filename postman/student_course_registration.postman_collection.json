    {
      "name": "Department write lifecycle",
      "item": [
        {
          "name": "Prepare unique values",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/health"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));"
                ]
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const suffix = Date.now().toString(36) + Math.random().toString(36).slice(2, 6);",
                  "pm.collectionVariables.set('demo_code', 'PM' + suffix);",
                  "pm.collectionVariables.set('demo_name', 'Postman ' + suffix);"
                ]
              }
            }
          ]
        },
        {
          "name": "Create",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/departments",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"department_code\": \"{{demo_code}}\",\n  \"department_name\": \"{{demo_name}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('demo_id', pm.response.json().department_id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Read created",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/departments/{{demo_id}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Replace",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/departments/{{demo_id}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"department_code\": \"{{demo_code}}\",\n  \"department_name\": \"{{demo_name}} updated\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Delete created",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{base_url}}/departments/{{demo_id}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 204', () => pm.response.to.have.status(204));"
                ]
              }
            }
          ]
        },
        {
          "name": "Confirm removed",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/departments/{{demo_id}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 404', () => pm.response.to.have.status(404));"
                ]
              }
            }
          ]
        }
      ]
    },
